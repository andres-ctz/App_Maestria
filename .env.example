# Variables del entorno local con Docker Compose (solo desarrollo).
# Copia este archivo a `.env` en la raíz si necesitas cambiar algún puerto o valor.
# Nunca subas `.env` al repositorio ni uses estas claves ficticias fuera de tu máquina.

# Zona horaria del sistema (D-009: hora de Ecuador)
TZ=America/Guayaquil

# PostgreSQL 16 (solo accesible desde 127.0.0.1)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=app_maestria
POSTGRES_USER=app_maestria
POSTGRES_PASSWORD=app_maestria_dev

# Cadena de conexión de referencia para el backend (NestJS + Prisma, Fase 2)
DATABASE_URL="postgresql://app_maestria:app_maestria_dev@127.0.0.1:5432/app_maestria?schema=public"

# Mailpit: servidor SMTP simulado para desarrollo local (D-008 y D-013)
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500
